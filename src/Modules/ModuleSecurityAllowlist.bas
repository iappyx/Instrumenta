Public Function IsAllowedProcedure(procName As String) As Boolean
    Dim n As String
    n = procName
    Dim p As Integer
    p = InStr(n, ".")
    If p > 0 Then n = Mid(n, p + 1)
    IsAllowedProcedure = AllowlistContains(GetAllowlist(), LCase(n))
End Function

'Scripting.Dictionary is not available on Mac, so the allowlist is a Collection
Private Function AllowlistContains(list As Collection, key As String) As Boolean
    Dim found As Boolean
    On Error Resume Next
    found = list(key)
    AllowlistContains = (Err.Number = 0) And found
    On Error GoTo 0
End Function


